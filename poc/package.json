{
  "name": "rhwp-md2hwpx-poc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PoC: Markdown -> HWPX via @rhwp/core (feasibility check)",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "poc": "tsx src/cli.ts",
    "make-template": "tsx scripts/make-template.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "web": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts"
  },
  "dependencies": {
    "@mermaid-js/mermaid-cli": "12.0.0",
    "@rhwp/core": "0.8.7",
    "@rhwp/editor": "0.8.7",
    "ajv": "8.20.0",
    "mermaid": "12.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}