{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "유스케이스 명세서 (PoC)",
  "type": "object",
  "required": ["meta", "items"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "version", "author", "date"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "number"] },
        "author": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "fields", "flows"],
        "properties": {
          "id": { "type": "string", "pattern": "^UC-\\d{3}$" },
          "name": { "type": "string", "minLength": 1 },
          "fields": {
            "type": "object",
            "required": ["액터", "사전조건", "사후조건"],
            "additionalProperties": { "type": "string" }
          },
          "flows": {
            "type": "object",
            "required": ["main"],
            "properties": {
              "main": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "alt": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    }
  }
}
