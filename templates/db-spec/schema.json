{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DB 명세서 (md 규약, 데이터 모양: meta + tables[{name,fields,columns,indexes}])",
  "type": "object",
  "required": ["meta", "tables"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "version", "author", "date"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "number"] },
        "author": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "fields", "columns"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "fields": { "type": "object", "required": ["설명"], "additionalProperties": { "type": "string" } },
          "columns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["컬럼명", "타입", "NULL"],
              "properties": { "NULL": { "enum": ["Y", "N"] } }
            }
          },
          "indexes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["인덱스명", "컬럼"],
              "properties": { "유니크": { "enum": ["Y", "N"] } }
            }
          }
        }
      }
    }
  }
}
