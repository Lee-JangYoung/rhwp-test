{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "클래스 명세서 (md 규약, 데이터 모양: meta + classes[{name,fields,attributes,methods[{name,fields,params}]}])",
  "type": "object",
  "required": ["meta", "classes"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "version", "author", "date"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "number"] },
        "author": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "fields"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
          "fields": { "type": "object", "required": ["패키지", "설명"], "additionalProperties": { "type": "string" } },
          "attributes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["이름", "타입"],
              "properties": { "이름": { "type": "string", "minLength": 1 } }
            }
          },
          "methods": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "fields"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "fields": { "type": "object", "required": ["설명"], "additionalProperties": { "type": "string" } },
                "params": {
                  "type": "array",
                  "items": { "type": "object", "required": ["이름", "타입"] }
                }
              }
            }
          }
        }
      }
    }
  }
}
