{
  "name": "yangsik",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "build": "pnpm -r build",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "yangsik": "node apps/cli/bin/yangsik.mjs",
    "gen:schema": "pnpm --filter @yangsik/tools gen:schema",
    "gen:docs": "pnpm --filter @yangsik/tools gen:docs",
    "gen:templates": "pnpm --filter @yangsik/tools gen:templates",
    "gen:profiles": "pnpm --filter @yangsik/tools gen:profiles",
    "kit:hancom": "pnpm --filter @yangsik/tools kit:hancom"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
